# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for Stripe success/cancel redirects, billing portal return URL, and OAuth callbacks.
APP_URL="http://localhost:3000"

# VITE_GA_MEASUREMENT_ID: Google Analytics Measurement ID (e.g., G-XXXXXXX)
# Set this to enable Google Analytics tracking for the dashboard.
VITE_GA_MEASUREMENT_ID=

# --- Stripe (client — baked into Vite build) ---
# Create Products & recurring Prices in Stripe Dashboard → Products.
# Monthly: $19.99/mo recurring. Annual: $200/yr recurring.
# Paste each Price ID (price_...) below. Must match server STRIPE_PRICE_* values.
VITE_STRIPE_PRICE_MONTHLY="price_..."
VITE_STRIPE_PRICE_ANNUAL="price_..."

# --- Stripe (server — server.ts only, never expose to the browser) ---
# Dashboard → Developers → API keys → Secret key
STRIPE_SECRET_KEY="sk_test_..."
# Dashboard → Developers → Webhooks → endpoint signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET="whsec_..."
# Same Price IDs as VITE_STRIPE_PRICE_* — used to validate checkout requests server-side
STRIPE_PRICE_MONTHLY="price_..."
STRIPE_PRICE_ANNUAL="price_..."

# --- Firebase Admin (server — webhook updates Firestore subscriptionStatus) ---
# Firebase Console → Project settings → Service accounts → Generate new private key
# Paste the entire JSON file contents as a single line:
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"..."}'
# Named Firestore database ID (see firebase-applet-config.json)
FIRESTORE_DATABASE_ID="ai-studio-gtiglobaltouring-e42b033f-32ed-4406-bd88-21ad9d69d2e9"
